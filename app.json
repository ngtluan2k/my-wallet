{
  "expo": {
    "name": "Ví Mình",
    "slug": "my-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ngtluan2k.viminh",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {},
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#009753",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sharing",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/BeVietnamPro_400Regular.ttf",
              "./assets/fonts/BeVietnamPro_500Medium.ttf",
              "./assets/fonts/BeVietnamPro_600SemiBold.ttf",
              "./assets/fonts/BeVietnamPro_700Bold.ttf",
              "./assets/fonts/BeVietnamPro_800ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "BeVietnamPro",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BeVietnamPro_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ví Mình dùng Face ID để mở khoá ứng dụng."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#1C4D86",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0B1420"
          }
        }
      ]
    ],
    "scheme": "mywallet",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "935264f7-3d6e-4af8-8593-fdf7d8c9e600"
      }
    }
  }
}
